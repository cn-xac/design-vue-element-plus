{
  "name": "@x-ac/design-vue-element-plus",
  "version": "0.4.0",
  "type": "module",
  "description": "基于 @x-ac/design-vue/kit 适配层的 Element Plus 扩展包：物料实现 + 绑定通道 + 动作副作用 + 设计器控件",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "schema",
    "low-code",
    "element-plus",
    "adapter"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs dist && vite build",
    "prepack": "pnpm run build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@x-ac/design-core": "^0.4.0",
    "@x-ac/design-vue": "^0.4.0",
    "element-plus": "^2.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@x-ac/design-core": "link:../project/packages/core",
    "@x-ac/design-vue": "link:../project/packages/vue",
    "element-plus": "^2.14.8",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
