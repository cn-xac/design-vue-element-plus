{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@x-ac/web-design-vue-element-plus": ["../src/index.ts"],
      "@x-ac/web-design-vue": ["../../project/packages/vue/src/index.ts"],
      "@x-ac/web-design-vue/kit": ["../../project/packages/vue/src/kit.ts"],
      "@x-ac/web-design-vue/designer": ["../../project/packages/vue/src/designer.ts"],
      "@x-ac/web-design-core": ["../../project/packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "env.d.ts"]
}
